# These may be changed to $(TOP_SRCDIR)/../openfx and $(TOP_SRCDIR)/../openfx-supportext if openfx and openfx-supportext are not included as submodules
OFXPATH ?= $(TOP_SRCDIR)/openfx
OFXSEXTPATH ?= $(TOP_SRCDIR)/SupportExt

PATHTOROOT = $(OFXPATH)/Support

include $(PATHTOROOT)/Plugins/Makefile.master

# C++ standard: C++17 by default (std::filesystem, OpenImageIO 3.x; some compilers, e.g. Apple clang, default to
# C++14), unless CXX, CXXFLAGS, CXXFLAGS_ADD or CXXFLAGS_EXTRA already has a -std option (like tests/Makefile's
# CXXSTD, which only checks CXX). CXXSTD's value is the whole compiler flag (e.g. -std=c++20), not a bare standard
# name such as openfx-cpp's c++17: an exported CXXSTD=c++17 would add a stray argument.
# E.g. `make CXXSTD=-std=c++20` or `make CXX="clang++ -std=c++20"` to compile as C++20.
# Only C++ (and Objective-C++) compiles use CXXFLAGS; the link line does not.
CXXSTD ?= $(if $(findstring -std=,$(CXX) $(CXXFLAGS) $(CXXFLAGS_ADD) $(CXXFLAGS_EXTRA)),,-std=c++17)
CXXFLAGS += $(CXXSTD)
CXXFLAGS += -DOFX_EXTENSIONS_VEGAS -DOFX_EXTENSIONS_NUKE -DOFX_EXTENSIONS_TUTTLE -DOFX_EXTENSIONS_NATRON -I$(TOP_SRCDIR)/IOSupport -I$(OFXSEXTPATH) -I$(OFXSEXTPATH)/glad
VPATH += $(TOP_SRCDIR)/IOSupport $(TOP_SRCDIR)/IOSupport/SequenceParsing $(OFXSEXTPATH) $(OFXSEXTPATH)/glad

# Comment the following two lines to disable OpenGL support in OpenColorIO plugins
OCIO_OPENGL_CXXFLAGS += -DOFX_SUPPORTS_OPENGLRENDER
# Comment the following three lines to disable OpenColorIO support
OCIO_CXXFLAGS += `pkg-config --cflags OpenColorIO` -DOFX_IO_USING_OCIO $(OCIO_OPENGL_CXXFLAGS)
OCIO_LINKFLAGS += `pkg-config --libs OpenColorIO` $(OCIO_OPENGL_LINKFLAGS)
ifeq ($(OS),Linux)
OCIO_LINKFLAGS += -Wl,-rpath,`pkg-config --variable=libdir OpenColorIO`
endif
ifeq ($(shell pkg-config --modversion OpenColorIO | sed -e 's/\..*//'),2)
#OCIO_OPENGL_LINKFLAGS += -lOpenColorIOoglapphelpers
endif

# OpenEXR
# OpenImageIO includes OpenEXR as #include <OpenEXR/ImathVec.h>, to we also add the
# include dir itself to avoid confusion with a system-installed OpenEXR.
# OpenEXR 2 has IlmBase, OpenEXR 3 has Imath, so we ask for both, but it will always cause harmless errors.
OPENEXR_CXXFLAGS = -I`pkg-config --variable=prefix OpenEXR`/include `pkg-config --cflags IlmBase 2>/dev/null` `pkg-config --cflags Imath 2>/dev/null` `pkg-config --cflags OpenEXR`
OPENEXR_LINKFLAGS =`pkg-config --libs IlmBase 2>/dev/null` `pkg-config --libs Imath 2>/dev/null` `pkg-config --libs OpenEXR`

# FFmpeg
# FFMPEG_PKG_CONFIG_PATH: optional pkg-config directory for FFmpeg (e.g. /opt/local/libexec/ffmpeg8/lib/pkgconfig
# for MacPorts' ffmpeg8 port). Empty (default): use the default pkg-config search path.
FFMPEG_PKG_CONFIG_PATH ?=
FFMPEG_PKG_CONFIG = $(if $(FFMPEG_PKG_CONFIG_PATH),PKG_CONFIG_PATH="$(FFMPEG_PKG_CONFIG_PATH):$$PKG_CONFIG_PATH" ,)pkg-config
FFMPEG_CXXFLAGS = `$(FFMPEG_PKG_CONFIG) --cflags libavformat libavcodec libswscale libavutil`
FFMPEG_LIBDIR := $(shell $(if $(FFMPEG_PKG_CONFIG_PATH),PKG_CONFIG_PATH="$(FFMPEG_PKG_CONFIG_PATH):$$PKG_CONFIG_PATH" ,)pkg-config --variable=libdir libavcodec 2>/dev/null)
ifneq ($(FFMPEG_PKG_CONFIG_PATH),)
# Link these libraries by full path: with -L/-l, another -L earlier on the link line (e.g. -L/opt/local/lib from
# OpenColorIO) would make the linker pick a different FFmpeg.
FFMPEG_LINKFLAGS = $(foreach l,avformat avcodec swscale avutil,$(FFMPEG_LIBDIR)/lib$(l)$(if $(filter Darwin,$(shell uname -s)),.dylib,.so))
else
FFMPEG_LINKFLAGS = `$(FFMPEG_PKG_CONFIG) --libs libavformat libavcodec libswscale libavutil`
endif
# (only on macOS, for the plugins that link FFmpeg, and not for "make clean")
FFMPEG_CHECK_BUNDLE := $(and $(filter Darwin,$(shell uname -s)),$(filter IO FFmpeg,$(PLUGINNAME)),$(if $(filter clean%,$(MAKECMDGOALS)),,yes))
ifneq ($(FFMPEG_CHECK_BUNDLE),)
# Guard: if OpenImageIO and the plugins link two different FFmpeg builds with the same soname (e.g. MacPorts' ffmpeg8
# in /opt/local/libexec/ffmpeg8 and Natron's ffmpeg in /opt/local/lib, both libavcodec.62.dylib), the deployment
# script (osxDeploy.sh copies libraries by name) silently bundles only one of them. Fail instead.
OIIO_AVCODEC := $(shell otool -L "$$(pkg-config --variable=libdir OpenImageIO 2>/dev/null)/libOpenImageIO.dylib" 2>/dev/null | awk '/libavcodec/{print $$1; exit}')
# The plugins' libavcodec install name, e.g. /opt/local/lib/libavcodec.62.dylib
FFMPEG_AVCODEC := $(shell otool -D "$(FFMPEG_LIBDIR)/libavcodec.dylib" 2>/dev/null | tail -1)
ifneq ($(and $(OIIO_AVCODEC),$(FFMPEG_AVCODEC)),)
# Two different FFmpegs with different sonames (e.g. libavcodec.62 and .63) can coexist in the bundle;
# with the same file name, only one of them would be bundled.
ifeq ($(notdir $(OIIO_AVCODEC)),$(notdir $(FFMPEG_AVCODEC)))
ifneq ($(OIIO_AVCODEC),$(FFMPEG_AVCODEC))
$(error OpenImageIO links $(OIIO_AVCODEC), but the FFmpeg plugins would link $(FFMPEG_AVCODEC): both are $(notdir $(OIIO_AVCODEC)), so the bundle would contain only one of them. Use the same FFmpeg for both, e.g. make FFMPEG_PKG_CONFIG_PATH=$(patsubst %/lib/,%/lib/pkgconfig,$(dir $(OIIO_AVCODEC))), or build OpenImageIO without FFmpeg)
endif
endif
endif
endif
# Uncomment the following line to enable multithreaded ffmpeg reading
FFMPEG_CXXFLAGS += -DOFX_IO_MT_FFMPEG

# OpenImageIO
# One pkg-config call per library: a library whose .pc file is broken (e.g. a Requires.private that is not found)
# must not drop the flags of the others.
OIIO_CXXFLAGS = $(OCIO_CXXFLAGS) `pkg-config --cflags OpenImageIO` $(OPENEXR_CXXFLAGS) -DOFX_IO_USING_LIBRAW `pkg-config --cflags libraw_r` `pkg-config --cflags libwebp` `pkg-config --cflags libtiff-4` `pkg-config --cflags libopenjp2` `pkg-config --cflags libpng`
OIIO_LINKFLAGS = $(OCIO_LINKFLAGS) `pkg-config --libs OpenImageIO` $(OPENEXR_LINKFLAGS) `pkg-config --libs libraw_r` `pkg-config --libs libwebp` `pkg-config --libs libtiff-4` `pkg-config --libs libopenjp2` `pkg-config --libs libpng`
ifeq ($(OS),Linux)
# libraw_r may be in a separate directory for licence reasons (eg in the Natron SDK)
OIIO_LINKFLAGS += -Wl,-rpath,`pkg-config --variable=prefix OpenImageIO`/lib -Wl,-rpath,`pkg-config --variable=libdir libraw_r`
endif

#SeExpr
SEEXPR_HOME ?=/usr
SEEXPR_CXXFLAGS = -I$(SEEXPR_HOME)/include
SEEXPR_LINKFLAGS = -L$(SEEXPR_HOME)/lib -lSeExpr
ifeq ($(OS),Linux)
SEEXPR_LINKFLAGS += -Wl,-rpath,$(SEEXPR_HOME)/lib
endif

#libPNG
PNG_CXXFLAGS = `pkg-config --cflags libpng`
PNG_LINKFLAGS = `pkg-config --libs libpng` -lz
ifeq ($(OS),Linux)
PNG_LINKFLAGS += -Wl,-rpath,`pkg-config --variable=libdir libpng`
endif
